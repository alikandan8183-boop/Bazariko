<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ثبت آگهی | بازاریکو</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Tahoma,Arial,sans-serif;
 background:#f3f5f8;
 color:#17243b;
}
header{
 background:#14243d;
 color:white;
 padding:22px 15px;
 text-align:center;
 border-bottom:4px solid #d9ad45;
}
header h1{margin:0;font-size:25px}
header p{margin:10px 0 0;color:#e5c875}
.container{
 max-width:650px;
 margin:25px auto;
 padding:20px;
}
.card{
 background:white;
 padding:22px;
 border-radius:16px;
 box-shadow:0 5px 22px #00000010;
}
h2{margin-top:0;color:#14243d}
label{
 display:block;
 margin:17px 0 8px;
 font-weight:bold;
}
input,select,textarea{
 width:100%;
 padding:13px;
 border:1px solid #d8dce4;
 border-radius:9px;
 font-family:inherit;
 font-size:15px;
 background:white;
}
textarea{min-height:110px;resize:vertical}
button{
 width:100%;
 padding:15px;
 margin-top:22px;
 border:0;
 border-radius:10px;
 background:#d9ad45;
 color:#14243d;
 font-size:17px;
 font-weight:bold;
 cursor:pointer;
}
.note{
 background:#fff8e8;
 padding:12px;
 border-radius:9px;
 font-size:13px;
 line-height:2;
 margin-top:15px;
}
.back{
 display:block;
 text-align:center;
 margin-top:18px;
 color:#14243d;
 text-decoration:none;
}
</style>
</head>

<body>

<header>
<h1>بازاریکو</h1>
<p>یک بازار، همه معاملات</p>
</header>

<div class="container">
<div class="card">

<h2>ثبت آگهی جدید</h2>
<p>اطلاعات کالای خود را وارد کنید.</p>

<form id="adForm">

<label>دسته‌بندی آگهی</label>
<select id="category" required>
<option value="">انتخاب کنید</option>
<option value="طلا و جواهر">طلا و جواهر</option>
<option value="آهن و فلزات">آهن و فلزات</option>
<option value="خودرو">خودرو</option>
<option value="ملک و زمین">ملک و زمین</option>
<option value="اجاره ویلا">اجاره ویلا</option>
<option value="کارخانه و کسب‌وکار">کارخانه و کسب‌وکار</option>
</select>

<label>عنوان آگهی</label>
<input id="title" type="text" placeholder="مثلاً فروش آپارتمان در تهران" required>

<label>قیمت (تومان)</label>
<input id="price" type="number" min="0" placeholder="قیمت را وارد کنید" required>

<label>شهر</label>
<input id="city" type="text" placeholder="نام شهر" required>

<label>شماره تماس</label>
<input id="phone" type="tel" placeholder="شماره تماس" required>

<label>توضیحات آگهی</label>
<textarea id="description" placeholder="توضیحات کامل محصول یا ملک خود را بنویسید..." required></textarea>

<button type="submit">ذخیره پیش‌نویس آگهی</button>

</form>

<div class="note">
توجه: در نسخه فعلی اطلاعات آگهی فقط به‌صورت پیش‌نویس روی همین دستگاه ذخیره می‌شود و هنوز برای عموم منتشر نمی‌شود.
</div>

<a class="back" href="index.html">بازگشت به صفحه اصلی</a>

</div>
</div>

<script>
const params = new URLSearchParams(window.location.search);
const selectedCategory = params.get("category");

if(selectedCategory){
 document.getElementById("category").value = selectedCategory;
}

document.getElementById("adForm").addEventListener("submit", function(e){
 e.preventDefault();

 const ad = {
  category: document.getElementById("category").value,
  title: document.getElementById("title").value,
  price: document.getElementById("price").value,
  city: document.getElementById("city").value,
  phone: document.getElementById("phone").value,
  description: document.getElementById("description").value,
  date: new Date().toISOString()
 };

 let ads = JSON.parse(localStorage.getItem("bazariko_ads") || "[]");
 ads.push(ad);
 localStorage.setItem("bazariko_ads", JSON.stringify(ads));

 alert("پیش‌نویس آگهی با موفقیت ذخیره شد.");
 this.reset();
});
</script>

</body>
</html>
